# Copy this file to .env (in the repo root) and pick ONE block below.
# The agent reads MODEL_ID and ANTHROPIC_BASE_URL; everything speaks the Anthropic Messages API.

# --- A. Local model via LM Studio, through the proxy (default) -------------
# The proxy listens on :8080 and forwards to LM Studio on :1234.
ANTHROPIC_BASE_URL=http://127.0.0.1:8080
ANTHROPIC_API_KEY=lm-studio            # any non-empty value; LM Studio ignores it
MODEL_ID=qwen/qwen3.5-9b

# --- B. Workshop key (OpenRouter), through the proxy -----------------------
# No model on your laptop? Use the key from your key card (limited, expires after the meetup).
# Start the proxy with: --mode reverse:https://openrouter.ai   (note the /api below)
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080/api
# ANTHROPIC_API_KEY=sk-or-v1-...
# MODEL_ID=qwen/qwen3.5-9b               # same model as the local path
# MODEL_ID=anthropic/claude-haiku-5.5    # or compare with a Claude model
# MODEL_ID=google/gemma-4-26b-a4b-it     # the strongest local model, hosted
# MODEL_ID=mistralai/ministral-3b-2512   # the weak local model: tool calls go wrong
# MODEL_ID=deepseek/deepseek-v4.1-flash  # a strong open-weights model

# --- C. Anthropic API, through the proxy ------------------------------------
# Start the proxy with: --mode reverse:https://api.anthropic.com
# ANTHROPIC_BASE_URL=http://127.0.0.1:8080
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_ID=claude-sonnet-4-6

# --- D. Other Anthropic-compatible providers --------------------------------
# Proxy: --mode reverse:<base url below>, then ANTHROPIC_BASE_URL=http://127.0.0.1:8080
# MiniMax   https://api.minimax.io/anthropic        MODEL_ID=MiniMax-M2.5
# GLM       https://api.z.ai/api/anthropic          MODEL_ID=glm-5
# Kimi      https://api.moonshot.ai/anthropic       MODEL_ID=kimi-k2.5
# DeepSeek  https://api.deepseek.com/anthropic      MODEL_ID=deepseek-chat
# ANTHROPIC_API_KEY=<provider key>

# --- E. Without the proxy -----------------------------------------------------
# Point straight at the model server (you won't see the traffic):
# ANTHROPIC_BASE_URL=http://127.0.0.1:1234      # LM Studio
# ANTHROPIC_BASE_URL=http://127.0.0.1:11434     # Ollama (recent versions)
# ANTHROPIC_BASE_URL=https://openrouter.ai/api  # workshop key
# (unset for Anthropic: the SDK then uses https://api.anthropic.com)

# --- Agent options -----------------------------------------------------------
# DEBUG=1          # print every request, token estimates and running cost
# AUTO_APPROVE=1   # j5_02: skip the y/n prompt before each tool call
